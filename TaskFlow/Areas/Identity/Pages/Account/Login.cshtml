@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="tf-auth-page">
    <div class="tf-auth-card">

        <div class="tf-eyebrow mb-3">WELCOME BACK</div>

        <h1 class="tf-auth-title">Sign in.</h1>

        <p class="tf-muted mb-4">
            Continue managing your projects and tasks.
        </p>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert">
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">
                    Email address
                </label>

                <input asp-for="Input.Email"
                       class="form-control tf-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">
                    Password
                </label>

                <input asp-for="Input.Password"
                       class="form-control tf-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger small">
                </span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input"
                       asp-for="Input.RememberMe" />

                <label asp-for="Input.RememberMe"
                       class="form-check-label tf-muted">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit"
                    type="submit"
                    class="btn btn-tf w-100 py-3">
                Sign in →
            </button>

            <div class="text-center mt-4">
                <a id="forgot-password"
                   asp-page="./ForgotPassword"
                   class="tf-link">
                    Forgot your password?
                </a>
            </div>

            <div class="tf-auth-divider"></div>

            <p class="text-center tf-muted mb-0">
                Don't have an account?
                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="tf-link">
                    Create one
                </a>
            </p>

            <p class="text-center mt-3 mb-0">
                <a id="resend-confirmation"
                   asp-page="./ResendEmailConfirmation"
                   class="tf-muted">
                    Resend email confirmation
                </a>
            </p>

        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="tf-auth-divider"></div>

            <h6 class="tf-muted mb-3">Or sign in using</h6>

            <form id="external-account"
                  asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-tf-outline w-100 mb-2"
                            name="provider"
                            value="@provider.Name"
                            title="Log in using your @provider.DisplayName account">
                        @provider.DisplayName
                    </button>
                }
            </form>
        }

    </div>

    <div class="tf-auth-side d-none d-lg-flex">
        <div>
            <div class="tf-eyebrow mb-3">YOUR WORKSPACE</div>

            <div class="tf-auth-mark">TF.</div>

            <h2>Make work flow better.</h2>

            <p class="tf-muted">
                One workspace. Every project. Every task.
                Keep your team focused and your progress moving.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}