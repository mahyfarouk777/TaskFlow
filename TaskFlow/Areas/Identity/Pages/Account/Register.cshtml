@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="tf-auth-page">
    <div class="tf-auth-card">

        <div class="tf-eyebrow mb-3">GET STARTED</div>

        <h1 class="tf-auth-title">Create account.</h1>

        <p class="tf-muted mb-4">
            Set up your workspace and start organizing your work.
        </p>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert">
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">
                    Email address
                </label>

                <input asp-for="Input.Email"
                       class="form-control tf-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">
                    Password
                </label>

                <input asp-for="Input.Password"
                       class="form-control tf-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Create a password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">
                    Confirm password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control tf-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm your password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger small">
                </span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="btn btn-tf w-100 py-3">
                Create account →
            </button>

            <div class="tf-auth-divider"></div>

            <p class="text-center tf-muted mb-0">
                Already have an account?
                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="tf-link">
                    Sign in
                </a>
            </p>

        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="tf-auth-divider"></div>

            <h6 class="tf-muted mb-3">Or register using</h6>

            <form id="external-account"
                  asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-tf-outline w-100 mb-2"
                            name="provider"
                            value="@provider.Name"
                            title="Register using your @provider.DisplayName account">
                        @provider.DisplayName
                    </button>
                }
            </form>
        }

    </div>

    <div class="tf-auth-side d-none d-lg-flex">
        <div>
            <div class="tf-eyebrow mb-3">PLAN / TRACK / DELIVER</div>

            <div class="tf-auth-mark">TF.</div>

            <h2>Your next move starts here.</h2>

            <p class="tf-muted">
                Bring your projects, tasks, and team together
                in one organized workspace.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}