```cshtml
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Update Task Status";
}

<h1>Update Task Status</h1>
<p class="text-muted">Update the progress of your assigned task.</p>

<div class="card mb-4">
    <div class="card-body">
        <h5>@Model.Title</h5>
        <p>@(Model.Description ?? "No description provided.")</p>
        <p><strong>Project:</strong> @(Model.Project?.Name ?? "Unknown")</p>
        <p><strong>Current status:</strong> @Model.Status</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="status" class="form-label">New Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="To Do" selected="@(Model.Status == "To Do")">To Do</option>
                    <option value="In Progress" selected="@(Model.Status == "In Progress")">In Progress</option>
                    <option value="Done" selected="@(Model.Status == "Done")">Done</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Save Status</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
```