```cshtml
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<h1>Delete Task</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this task? This action cannot be undone.
</div>

<div class="card mb-4">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <p>@(Model.Description ?? "No description provided.")</p>
        <p><strong>Project:</strong> @(Model.Project?.Name ?? "Unknown")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Priority:</strong> @Model.Priority</p>
        <p><strong>Due Date:</strong> @(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete Task</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
```