@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="tf-page">

    <section class="tf-page-header">
        <div>
            <div class="tf-eyebrow mb-3">WORKSPACE / TASKS / DELETE</div>
            <h1>Delete task<span class="tf-accent">.</span></h1>
            <p class="tf-muted mb-0">
                Review the task details before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-tf-outline">Back to tasks</a>
    </section>

    <div class="tf-card mt-4">

        <div class="tf-danger p-3 rounded-3 mb-4">
            <div class="fw-semibold mb-1">Are you sure?</div>
            <div class="small">
                This task will be permanently deleted. This action cannot be undone.
            </div>
        </div>

        <div class="tf-eyebrow mb-2">TASK TO BE DELETED</div>
        <h2 class="mb-2">@Model.Title</h2>

        <p class="tf-muted mb-4">
            @(Model.Description ?? "No description provided.")
        </p>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">PROJECT</div>
                    <div class="fw-semibold">
                        @(Model.Project?.Name ?? "Unknown")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">DUE DATE</div>
                    <div class="fw-semibold">
                        @(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">STATUS</div>
                    <span class="tf-badge @(Model.Status == "Done" ? "tf-status-done" : Model.Status == "In Progress" ? "tf-status-progress" : "tf-status-todo")">
                        @Model.Status
                    </span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">PRIORITY</div>
                    <span class="tf-badge @(Model.Priority == "High" ? "tf-priority-high" : Model.Priority == "Medium" ? "tf-priority-medium" : "tf-priority-low")">
                        @Model.Priority
                    </span>
                </div>
            </div>

        </div>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              class="mt-4 pt-3 border-top">

            <div class="d-flex flex-column flex-sm-row gap-2">
                <button type="submit" class="btn btn-danger px-4">
                    Delete task
                </button>

                <a asp-action="Index" class="btn btn-tf-outline px-4">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>
