
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="container py-5">

    <div class="p-4 p-md-5 mb-4 bg-danger text-white rounded-4 shadow">
        <span class="badge bg-white text-danger rounded-pill px-3 py-2 mb-3">
            Task Management
        </span>
        <h1 class="display-5 fw-bold mb-3">Delete Task</h1>
        <p class="fs-5 text-white-50 mb-0">
            Review the task details before permanently deleting it.
        </p>
    </div>

    <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-2">Are you sure?</h5>
        <p class="mb-0">
            This task will be permanently deleted. This action cannot be undone.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h3 class="fw-bold mb-2">@Model.Title</h3>
                    <p class="text-muted mb-4">
                        @(Model.Description ?? "No description provided.")
                    </p>

                    <hr class="mb-4" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Project</div>
                                <div class="fw-semibold">@(Model.Project?.Name ?? "Unknown")</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Due Date</div>
                                <div class="fw-semibold">
                                    @(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Status</div>
                                <div class="fw-semibold">@Model.Status</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Priority</div>
                                <div class="fw-semibold">@Model.Priority</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4 pt-3 border-top">
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit" class="btn btn-danger px-4">Delete Task</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
