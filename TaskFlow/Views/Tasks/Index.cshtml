
@model TaskFlow.ViewModels.TaskListViewModel

@{
    ViewData["Title"] = "Tasks";
}

<div class="tf-page">

    <section class="tf-page-header">
        <div>
            <div class="tf-eyebrow mb-3">WORKSPACE / TASK MANAGEMENT</div>
            <h1>Tasks<span class="tf-accent">.</span></h1>
            <p class="tf-muted mb-0">
                Track progress, manage priorities, and stay on top of your work.
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
        {
            <a asp-action="Create" class="btn btn-tf">+ New task</a>
        }
    </section>

    <div class="tf-card mt-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <div class="tf-eyebrow mb-2">YOUR WORKSPACE</div>
                <h4 class="mb-1">All tasks</h4>
                <p class="tf-muted mb-0">Search and filter your tasks below.</p>
            </div>

            <span class="tf-badge">@Model.TotalItems TASKS</span>
        </div>

        <form asp-action="Index" method="get" class="mb-4">
            <input type="hidden" name="PageNumber" value="1" />

            <div class="row g-2">

                <div class="col-12 col-md-4">
                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Search tasks..."
                           aria-label="Search tasks" />
                </div>

                <div class="col-6 col-md-2">
                    <select asp-for="TaskStatusId" class="form-select">
                        <option value="">All statuses</option>
                        @foreach (var status in Model.TaskStatuses)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select asp-for="Priority" class="form-select">
                        <option value="">All priorities</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select asp-for="SortOrder" class="form-select">
                        <option value="title">Sort by title</option>
                        <option value="dueDate">Sort by due date</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-tf flex-grow-1">
                        Filter
                    </button>
                    <a asp-action="Index" class="btn btn-tf-outline">Clear</a>
                </div>

            </div>
        </form>

        <div class="table-responsive">

            @if (Model.Tasks.Any())
            {
                <table class="table tf-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Due date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@task.Title</div>
                                </td>

                                <td>
                                    <span class="tf-muted">
                                        @(task.Project?.Name ?? "Unknown")
                                    </span>
                                </td>

                                <td>
                                    @{
                                        var statusName = task.TaskStatus?.Name ?? "Unknown";
                                    }

                                    <span class="tf-badge @(statusName == "Done" ? "tf-status-done" : statusName == "In Progress" ? "tf-status-progress" : "tf-status-todo")">
                                        @statusName
                                    </span>
                                </td>

                                <td>
                                    <span class="tf-badge @(task.Priority == "High" ? "tf-priority-high" : task.Priority == "Medium" ? "tf-priority-medium" : "tf-priority-low")">
                                        @task.Priority
                                    </span>
                                </td>

                                <td class="text-nowrap">
                                    <span class="tf-muted">
                                        @(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <a asp-action="Details"
                                           asp-route-id="@task.Id"
                                           class="btn btn-sm btn-tf-outline">
                                            Details
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-tf-outline">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm tf-danger">
                                                Delete
                                            </a>
                                        }
                                        else if (User.IsInRole("TeamMember"))
                                        {
                                            <a asp-action="UpdateStatus"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-tf">
                                                Update status
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="tf-muted small mt-3">
                    Showing @Model.Tasks.Count() of @Model.TotalItems task(s)
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Task pagination">
                        <ul class="pagination justify-content-center">

                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-TaskStatusId="@Model.TaskStatusId"
                                   asp-route-Priority="@Model.Priority"
                                   asp-route-SortOrder="@Model.SortOrder"
                                   asp-route-PageNumber="@(Model.PageNumber - 1)">
                                    Previous
                                </a>
                            </li>

                            @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-TaskStatusId="@Model.TaskStatusId"
                                       asp-route-Priority="@Model.Priority"
                                       asp-route-SortOrder="@Model.SortOrder"
                                       asp-route-PageNumber="@pageNumber">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-TaskStatusId="@Model.TaskStatusId"
                                   asp-route-Priority="@Model.Priority"
                                   asp-route-SortOrder="@Model.SortOrder"
                                   asp-route-PageNumber="@(Model.PageNumber + 1)">
                                    Next
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="tf-eyebrow mb-3">NOTHING HERE YET</div>
                    <h4>No tasks found.</h4>
                    <p class="tf-muted mb-4">
                        Try changing your search or filter criteria.
                    </p>
                    <a asp-action="Index" class="btn btn-tf-outline">
                        Clear filters
                    </a>
                </div>
            }

        </div>
    </div>
</div>
