```cshtml
@model IEnumerable<TaskFlow.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Tasks</h1>
        <p class="text-muted">Track and manage your work.</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
    {
        <a asp-action="Create" class="btn btn-primary">+ New Task</a>
    }
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <input name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Search tasks..." />
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                <option value="To Do" selected="@(ViewData["CurrentStatus"]?.ToString() == "To Do")">To Do</option>
                <option value="In Progress" selected="@(ViewData["CurrentStatus"]?.ToString() == "In Progress")">In Progress</option>
                <option value="Done" selected="@(ViewData["CurrentStatus"]?.ToString() == "Done")">Done</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">All priorities</option>
                <option value="Low" selected="@(ViewData["CurrentPriority"]?.ToString() == "Low")">Low</option>
                <option value="Medium" selected="@(ViewData["CurrentPriority"]?.ToString() == "Medium")">Medium</option>
                <option value="High" selected="@(ViewData["CurrentPriority"]?.ToString() == "High")">High</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Task</th>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td class="fw-semibold">@task.Title</td>
                        <td>@(task.Project?.Name ?? "Unknown")</td>
                        <td>
                            <span class="badge @(task.Status == "Done" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                @task.Status
                            </span>
                        </td>
                        <td>
                            <span class="badge @(task.Priority == "High" ? "bg-danger" : task.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                @task.Priority
                            </span>
                        </td>
                        <td>@(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-primary">Details</a>

                                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@task.Id"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>

                                    <a asp-action="Delete" asp-route-id="@task.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                                else if (User.IsInRole("TeamMember"))
                                {
                                    <a asp-action="UpdateStatus" asp-route-id="@task.Id"
                                       class="btn btn-sm btn-outline-success">Update Status</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No tasks found.</div>
}
```