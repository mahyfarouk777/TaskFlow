
@model IEnumerable<TaskFlow.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<div class="container py-5">

    <div class="p-4 p-md-5 mb-4 bg-primary text-white rounded-4 shadow">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-white text-primary rounded-pill px-3 py-2 mb-3">
                    Task Management
                </span>
                <h1 class="display-5 fw-bold mb-3">Tasks</h1>
                <p class="fs-5 text-white-50 mb-0">
                    Track progress, manage priorities, and stay on top of your work.
                </p>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
            {
                <a asp-action="Create" class="btn btn-light text-primary px-4">
                    + New Task
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="mb-4">
                <h4 class="fw-bold mb-1">All Tasks</h4>
                <p class="text-muted mb-0">Search and filter your tasks below.</p>
            </div>

            <form asp-action="Index" method="get" class="mb-4">
                <div class="row g-2">
                    <div class="col-12 col-md-5">
                        <input name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Search tasks..."
                               aria-label="Search tasks" />
                    </div>

                    <div class="col-6 col-md-3">
                        <select name="status" class="form-select">
                            <option value="">All statuses</option>
                            <option value="To Do" selected="@(ViewData["CurrentStatus"]?.ToString() == "To Do")">To Do</option>
                            <option value="In Progress" selected="@(ViewData["CurrentStatus"]?.ToString() == "In Progress")">In Progress</option>
                            <option value="Done" selected="@(ViewData["CurrentStatus"]?.ToString() == "Done")">Done</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select name="priority" class="form-select">
                            <option value="">All priorities</option>
                            <option value="Low" selected="@(ViewData["CurrentPriority"]?.ToString() == "Low")">Low</option>
                            <option value="Medium" selected="@(ViewData["CurrentPriority"]?.ToString() == "Medium")">Medium</option>
                            <option value="High" selected="@(ViewData["CurrentPriority"]?.ToString() == "High")">High</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </form>

            <hr class="mb-4" />

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3 py-3">Task</th>
                                <th class="py-3">Project</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Priority</th>
                                <th class="py-3">Due Date</th>
                                <th class="text-end px-3 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model)
                            {
                                <tr>
                                    <td class="px-3 py-3 fw-semibold">@task.Title</td>
                                    <td class="py-3">@(task.Project?.Name ?? "Unknown")</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-2 @(task.Status == "Done" ? "bg-success-subtle text-success" : task.Status == "In Progress" ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary")">
                                            @task.Status
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-2 @(task.Priority == "High" ? "bg-danger-subtle text-danger" : task.Priority == "Medium" ? "bg-warning-subtle text-warning-emphasis" : "bg-secondary-subtle text-secondary")">
                                            @task.Priority
                                        </span>
                                    </td>
                                    <td class="py-3 text-nowrap">
                                        @(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </td>
                                    <td class="text-end px-3 py-3">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-action="Details" asp-route-id="@task.Id"
                                               class="btn btn-sm btn-outline-primary">Details</a>

                                            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@task.Id"
                                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@task.Id"
                                                   class="btn btn-sm btn-outline-danger">Delete</a>
                                            }
                                            else if (User.IsInRole("TeamMember"))
                                            {
                                                <a asp-action="UpdateStatus" asp-route-id="@task.Id"
                                                   class="btn btn-sm btn-outline-success">Update Status</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 rounded-4 text-center py-5 mb-0">
                    <h5 class="fw-bold mb-2">No Tasks Found</h5>
                    <p class="mb-3">Try changing your search or filter criteria.</p>
                    <a asp-action="Index" class="btn btn-outline-primary px-4">Clear Filters</a>
                </div>
            }

        </div>
    </div>
</div>
