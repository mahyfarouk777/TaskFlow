@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Create Task";
}

<div class="tf-page">

    <section class="tf-page-header">
        <div>
            <div class="tf-eyebrow mb-3">WORKSPACE / TASKS / NEW</div>
            <h1>Create task<span class="tf-accent">.</span></h1>
            <p class="tf-muted mb-0">
                Add a task, assign it to a project, and define its priority.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-tf-outline">Back to tasks</a>
    </section>

    <div class="row justify-content-center mt-4">
        <div class="col-12 col-lg-8">

            <div class="tf-form-card">
                <div class="tf-eyebrow mb-2">TASK CONFIGURATION</div>
                <h4 class="mb-1">Task information</h4>
                <p class="tf-muted mb-4">Fill in the details below.</p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label">Task title</label>
                        <input asp-for="Title" class="form-control" placeholder="Enter task title" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the task"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProjectId" class="form-label">Project</label>
                        <select asp-for="ProjectId"
                                asp-items="ViewBag.ProjectId"
                                class="form-select">
                            <option value="">-- Select a project --</option>
                        </select>
                        <span asp-validation-for="ProjectId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="To Do">To Do</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Done">Done</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DueDate" class="form-label">Due date</label>
                        <input asp-for="DueDate" type="date" class="form-control" />
                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AssignedToUserId" class="form-label">Assign to</label>
                        <select asp-for="AssignedToUserId"
                                asp-items="ViewBag.AssignedToUserId"
                                class="form-select">
                            <option value="">-- Unassigned --</option>
                        </select>
                        <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-tf px-4">Create task</button>
                        <a asp-action="Index" class="btn btn-tf-outline px-4">Cancel</a>
                    </div>

                </form>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
