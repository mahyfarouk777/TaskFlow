@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="tf-page">

    <section class="tf-page-header">
        <div>
            <div class="tf-eyebrow mb-3">WORKSPACE / TASKS / DETAILS</div>
            <h1>Task details<span class="tf-accent">.</span></h1>
            <p class="tf-muted mb-0">
                View task information, project details, and current progress.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-tf-outline">← Back to tasks</a>
    </section>

    <div class="tf-card mt-4">

        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-start mb-4">
            <div>
                <div class="tf-eyebrow mb-2">TASK INFORMATION</div>
                <h2 class="mb-2">@Model.Title</h2>
                <p class="tf-muted mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </p>
            </div>

            <span class="tf-badge @(Model.Status == "Done" ? "tf-status-done" : Model.Status == "In Progress" ? "tf-status-progress" : "tf-status-todo")">
                @Model.Status
            </span>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">PROJECT</div>

                    @if (Model.Project != null)
                    {
                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@Model.ProjectId"
                           class="tf-link fw-semibold">
                            @Model.Project.Name
                        </a>
                    }
                    else
                    {
                        <div class="tf-muted">Unknown</div>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">PRIORITY</div>

                    <span class="tf-badge @(Model.Priority == "High" ? "tf-priority-high" : Model.Priority == "Medium" ? "tf-priority-medium" : "tf-priority-low")">
                        @Model.Priority
                    </span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">DUE DATE</div>
                    <div class="fw-semibold">
                        @(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="tf-info h-100">
                    <div class="tf-eyebrow mb-2">TASK ID</div>
                    <div class="fw-semibold">#@Model.Id</div>
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">

        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-tf">
                Edit task
            </a>
        }
        else if (User.IsInRole("TeamMember"))
        {
            <a asp-action="UpdateStatus"
               asp-route-id="@Model.Id"
               class="btn btn-tf">
                Update status
            </a>
        }

        <a asp-action="Index" class="btn btn-tf-outline">
            Back to tasks
        </a>

    </div>

</div>
