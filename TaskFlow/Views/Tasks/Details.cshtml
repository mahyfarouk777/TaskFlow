```cshtml
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Model.Title</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Tasks</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)
            </dd>

            <dt class="col-sm-3">Project</dt>
            <dd class="col-sm-9">
                @if (Model.Project != null)
                {
                    <a asp-controller="Projects" asp-action="Details"
                       asp-route-id="@Model.ProjectId">@Model.Project.Name</a>
                }
                else
                {
                    <span>Unknown</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-primary">Edit Task</a>
    }
    else if (User.IsInRole("TeamMember"))
    {
        <a asp-action="UpdateStatus" asp-route-id="@Model.Id"
           class="btn btn-success">Update Status</a>
    }

    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>
```