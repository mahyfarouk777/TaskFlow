@model IEnumerable<TaskFlow.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="tf-page">

    <!-- Header -->
    <section class="tf-page-header">

        <div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center gap-4">

            <div>
                <div class="tf-eyebrow mb-3">
                    WORKSPACE / PROJECTS
                </div>

                <h1 class="mb-3">Your projects.</h1>

                <p class="tf-muted mb-0">
                    Every project has a plan. Every plan starts here.
                    Keep your work organized and moving forward.
                </p>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
            {
                <a asp-action="Create" class="btn btn-tf">
                    + New project
                </a>
            }

        </div>

    </section>

    <!-- Project Workspace -->
    <section>

        <div class="d-flex justify-content-between align-items-end mb-4">

            <div>
                <div class="tf-eyebrow mb-2">YOUR WORKSPACE</div>
                <h2 class="fw-bold mb-1">Project directory.</h2>
                <p class="tf-muted mb-0">
                    Browse, review, and manage your projects.
                </p>
            </div>

            <span class="tf-badge">
                @(Model.Count()) PROJECTS
            </span>

        </div>

        <!-- Search -->
        <div class="tf-card mb-4">

            <form asp-action="Index"
                  method="get">

                <div class="row align-items-end g-3">

                    <div class="col-md">
                        <label class="form-label fw-semibold">
                            Find a project
                        </label>

                        <input name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               style="background:#111713;
                        color:var(--tf-text);
                        border:1px solid var(--tf-border);
                        border-radius:10px;
                        padding:13px;"
                               placeholder="Search by project name or description..."
                               aria-label="Search projects" />
                    </div>

                    <div class="col-md-auto d-flex gap-2">

                        <button type="submit"
                                class="btn btn-tf">
                            Search →
                        </button>

                        <a asp-action="Index"
                           class="btn btn-tf-outline">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

        <!-- Project List -->
        @if (Model.Any())
        {
            <div class="tf-card p-0">

                <div class="d-flex justify-content-between
                    align-items-center p-4">

                    <div>
                        <h5 class="fw-bold mb-1">All projects</h5>
                        <p class="tf-muted small mb-0">
                            Your current project overview.
                        </p>
                    </div>

                    <span class="tf-muted small">
                        LATEST OVERVIEW
                    </span>

                </div>

                <div class="table-responsive">

                    <table class="table tf-table align-middle">

                        <thead>
                            <tr>
                                <th class="ps-4">PROJECT</th>
                                <th>DESCRIPTION</th>
                                <th>START DATE</th>
                                <th>DEADLINE</th>
                                <th class="text-center">TASKS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var project in Model)
                            {
                                <tr>

                                    <!-- Project -->
                                    <td class="ps-4" style="min-width:160px;">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center
                                                justify-content-center rounded-3"
                                                 style="width:40px;height:40px;
                                                background:rgba(197,243,107,.12);
                                                color:var(--tf-lime);
                                                font-weight:800;">
                                                @project.Name.Substring(0, 1).ToUpper()
                                            </div>

                                            <span class="fw-bold">
                                                @project.Name
                                            </span>

                                        </div>

                                    </td>

                                    <!-- Description -->
                                    <td style="min-width:200px;max-width:300px;">

                                        <span class="tf-muted"
                                              style="font-size:.85rem;">
                                            @(string.IsNullOrWhiteSpace(project.Description)
                                                ? "No description provided."
                                                : project.Description)
                                        </span>

                                    </td>

                                    <!-- Start Date -->
                                    <td class="text-nowrap">
                                        @project.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- Deadline -->
                                    <td class="text-nowrap">

                                        @if (project.Deadline.HasValue)
                                        {
                                            @project.Deadline.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="tf-muted">Not set</span>
                                        }

                                    </td>

                                    <!-- Tasks -->
                                    <td class="text-center">

                                        <span class="tf-badge">
                                            @project.Tasks.Count
                                        </span>

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4"
                                        style="min-width:190px;">

                                        <div class="d-flex justify-content-end
                                            gap-2 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@project.Id"
                                               class="btn btn-sm btn-tf-outline">
                                                View
                                            </a>

                                            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@project.Id"
                                                   class="btn btn-sm btn-tf-outline">
                                                    Edit
                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@project.Id"
                                                   class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="px-4 py-3"
                     style="border-top:1px solid var(--tf-border);">

                    <span class="tf-muted small">
                        Showing @Model.Count() project(s)
                    </span>

                </div>

            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="tf-card text-center py-5">

                <div style="font-size:3.5rem;color:var(--tf-lime);">
                    ◈
                </div>

                <div class="tf-eyebrow mt-3 mb-2">
                    NOTHING HERE YET
                </div>

                <h3 class="fw-bold mb-2">
                    No projects found.
                </h3>

                <p class="tf-muted mx-auto mb-4"
                   style="max-width:450px;">
                    No projects match your search.
                    Try another keyword or start something new.
                </p>

                <div class="d-flex justify-content-center
                    flex-wrap gap-2">

                    <a asp-action="Index"
                       class="btn btn-tf-outline">
                        Clear search
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                    {
                        <a asp-action="Create"
                           class="btn btn-tf">
                            + Create project
                        </a>
                    }

                </div>

            </div>
        }

    </section>

    <!-- Bottom Note -->
    <div class="mt-5 d-flex justify-content-between
        align-items-center flex-wrap gap-2">

        <span class="tf-muted small">
            TASKFLOW / PROJECT MANAGEMENT
        </span>

        <span class="tf-accent small fw-bold">
            PLAN. TRACK. DELIVER.
        </span>

    </div>

</div>
