```cshtml
@model IEnumerable<TaskFlow.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Projects</h1>
        <p class="text-muted">Manage and track your projects.</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
    {
        <a asp-action="Create" class="btn btn-primary">+ New Project</a>
    }
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search projects..." />

        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Start Date</th>
                    <th>Deadline</th>
                    <th>Tasks</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model)
                {
                    <tr>
                        <td class="fw-semibold">@project.Name</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(project.Description)
                                ? "No description"
                                : project.Description)
                        </td>
                        <td>@project.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@(project.Deadline?.ToString("dd MMM yyyy") ?? "Not set")</td>
                        <td>
                            <span class="badge bg-secondary">@project.Tasks.Count</span>
                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@project.Id"
                                   class="btn btn-sm btn-outline-primary">Details</a>

                                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@project.Id"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>

                                    <a asp-action="Delete" asp-route-id="@project.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No projects found. Try another search or create a project.
    </div>
}
```