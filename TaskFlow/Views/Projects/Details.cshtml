@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="tf-page">

    <!-- Project Header -->
    <section class="tf-page-header">

        <div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center gap-4">

            <div>
                <div class="tf-eyebrow mb-3">
                    WORKSPACE / PROJECTS / OVERVIEW
                </div>

                <h1 class="mb-3">@Model.Name</h1>

                <p class="tf-muted mb-0">
                    Your project workspace. Everything starts here.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">

                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-tf">
                        Edit project
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-tf-outline">
                    ← Projects
                </a>

            </div>

        </div>
    </section>

    <!-- Project Information -->
    <div class="mb-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="tf-eyebrow mb-2">PROJECT OVERVIEW</div>
                <h2 class="fw-bold mb-0">The bigger picture.</h2>
            </div>

            <span class="tf-badge">PROJECT #@Model.Id</span>
        </div>

        <div class="tf-card">

            <div class="mb-4">
                <div class="tf-eyebrow mb-2">DESCRIPTION</div>

                <p class="mb-0" style="line-height:1.9;color:#d1d9cf;">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </p>
            </div>

            <hr class="my-4" />

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="tf-info">
                        <small>START DATE</small>
                        <strong>
                            @Model.StartDate.ToString("dd MMM yyyy")
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="tf-info">
                        <small>DEADLINE</small>
                        <strong>
                            @(Model.Deadline?.ToString("dd MMM yyyy") ?? "Not set")
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="tf-info">
                        <small>TOTAL TASKS</small>
                        <strong class="tf-accent"
                                style="font-size:1.5rem;">
                            @Model.Tasks.Count
                        </strong>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Tasks Section -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="tf-eyebrow mb-2">WORK BREAKDOWN</div>
            <h2 class="fw-bold mb-1">Project tasks.</h2>
            <p class="tf-muted mb-0">
                All tasks connected to this project.
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
        {
            <a asp-controller="Tasks"
               asp-action="Create"
               asp-route-projectId="@Model.Id"
               class="btn btn-tf">
                + Add task
            </a>
        }

    </div>

    @if (Model.Tasks.Any())
    {
        <div class="tf-card p-0">

            <div class="table-responsive">
                <table class="table tf-table align-middle">

                    <thead>
                        <tr>
                            <th class="ps-4">TASK</th>
                            <th>STATUS</th>
                            <th>PRIORITY</th>
                            <th>DUE DATE</th>
                            <th class="text-end pe-4">ACTION</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold">
                                        @task.Title
                                    </span>
                                </td>

                                <td>
                                    <span class="tf-badge">
                                        @task.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="text-white-50">
                                        @task.Priority
                                    </span>
                                </td>

                                <td class="tf-muted">
                                    @(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                </td>

                                <td class="text-end pe-4">
                                    <a asp-controller="Tasks"
                                       asp-action="Details"
                                       asp-route-id="@task.Id"
                                       class="btn btn-sm btn-tf-outline">
                                        View →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    }
    else
    {
        <div class="tf-card text-center py-5">

            <div style="font-size:3rem;color:var(--tf-lime);">
                ◈
            </div>

            <h4 class="fw-bold mt-3">Nothing on the board yet.</h4>

            <p class="tf-muted mb-4">
                This project doesn't have any tasks assigned to it yet.
            </p>

            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
            {
                <a asp-controller="Tasks"
                   asp-action="Create"
                   asp-route-projectId="@Model.Id"
                   class="btn btn-tf">
                    Create first task →
                </a>
            }

        </div>
    }

</div>
