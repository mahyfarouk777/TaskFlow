```cshtml
@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="container py-5">

    <!-- Header -->
    <div class="p-4 p-md-5 mb-4 bg-primary text-white rounded-4 shadow">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

            <div>
                <span class="badge bg-white text-primary rounded-pill px-3 py-2 mb-3">
                    Project Management
                </span>

                <h1 class="display-5 fw-bold mb-3">@Model.Name</h1>

                <p class="fs-5 text-white-50 mb-0">
                    View project information, track progress, and manage associated tasks.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-light text-primary px-4">
                        Edit Project
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-outline-light px-4">
                    Back to Projects
                </a>
            </div>

        </div>
    </div>

    <!-- Project Information -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">

            <div class="d-flex align-items-center mb-4">
                <div class="me-3 p-3 bg-primary-subtle rounded-3">
                    <i class="bi bi-folder2-open text-primary fs-4"></i>
                </div>

                <div>
                    <h4 class="fw-bold mb-1">Project Information</h4>
                    <p class="text-muted mb-0">
                        Overview of your project details
                    </p>
                </div>
            </div>

            <hr class="mb-4" />

            <div class="row g-4">

                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <div class="text-muted small mb-2">Description</div>
                        <div class="fw-medium">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description provided."
                                : Model.Description)
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small mb-2">Start Date</div>
                        <div class="fw-semibold">
                            @Model.StartDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="text-muted small mb-2">Deadline</div>
                        <div class="fw-semibold">
                            @(Model.Deadline?.ToString("dd MMM yyyy") ?? "Not set")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-primary-subtle rounded-3 h-100">
                        <div class="text-primary small mb-2">Total Tasks</div>
                        <div class="fw-bold text-primary fs-3">
                            @Model.Tasks.Count
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Project Tasks -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-2">Project Tasks</h2>
            <p class="text-muted mb-0">
                View and track the tasks associated with this project.
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
        {
            <a asp-controller="Tasks"
               asp-action="Create"
               asp-route-projectId="@Model.Id"
               class="btn btn-primary px-4">
                + Add Task
            </a>
        }

    </div>

    @if (Model.Tasks.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Task</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Priority</th>
                                <th class="py-3">Due Date</th>
                                <th class="text-end px-4 py-3">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var task in Model.Tasks)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <span class="fw-semibold">@task.Title</span>
                                    </td>

                                    <td class="py-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            @task.Status
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                            @task.Priority
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        @(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </td>

                                    <td class="text-end px-4 py-3">
                                        <a asp-controller="Tasks"
                                           asp-action="Details"
                                           asp-route-id="@task.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5 px-4">
                <div class="mb-3">
                    <i class="bi bi-clipboard-check text-muted" style="font-size: 3rem;"></i>
                </div>

                <h5 class="fw-bold mb-2">No Tasks Yet</h5>

                <p class="text-muted mb-4">
                    There are no tasks associated with this project yet.
                </p>

                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                {
                    <a asp-controller="Tasks"
                       asp-action="Create"
                       asp-route-projectId="@Model.Id"
                       class="btn btn-primary px-4">
                        Create First Task
                    </a>
                }
            </div>
        </div>
    }

</div>
```