```cshtml
@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<h1>Delete Project</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this project? Its associated tasks will also be deleted.
</div>

<div class="card mb-4">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <p>@(Model.Description ?? "No description provided.")</p>
        <p><strong>Start Date:</strong> @Model.StartDate.ToString("dd MMM yyyy")</p>
        <p><strong>Deadline:</strong> @(Model.Deadline?.ToString("dd MMM yyyy") ?? "Not set")</p>
        <p><strong>Tasks:</strong> @Model.Tasks.Count</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete Project</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
```