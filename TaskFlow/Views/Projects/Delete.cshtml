@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="tf-page">

    <div class="tf-page-header">
        <div class="tf-eyebrow mb-3" style="color:#ff7777;">
            WORKSPACE / PROJECTS / DELETE
        </div>

        <h1>One last check.</h1>

        <p class="tf-muted mb-0">
            Review the project before permanently removing it.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- Warning -->
            <div class="tf-danger mb-4">

                <div class="d-flex gap-3 align-items-start">
                    <div style="font-size:1.6rem;">⚠</div>

                    <div>
                        <h5 class="fw-bold mb-2">
                            This action cannot be undone.
                        </h5>

                        <p class="mb-0">
                            Deleting this project will also delete
                            its associated tasks. Make sure you
                            really want to continue.
                        </p>
                    </div>
                </div>

            </div>

            <!-- Project Details -->
            <div class="tf-card">

                <div class="d-flex justify-content-between
                    align-items-start flex-wrap gap-3 mb-4">

                    <div>
                        <div class="tf-eyebrow mb-2">
                            PROJECT TO BE DELETED
                        </div>

                        <h2 class="fw-bold mb-2">
                            @Model.Name
                        </h2>

                        <p class="tf-muted mb-0">
                            @(Model.Description ?? "No description provided.")
                        </p>
                    </div>

                    <span class="badge rounded-pill px-3 py-2"
                          style="background:rgba(255,119,119,.12);
                        color:#ff7777;">
                        PENDING DELETION
                    </span>

                </div>

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="tf-info">
                            <small>START DATE</small>
                            <strong>
                                @Model.StartDate.ToString("dd MMM yyyy")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tf-info">
                            <small>DEADLINE</small>
                            <strong>
                                @(Model.Deadline?.ToString("dd MMM yyyy") ?? "Not set")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tf-info">
                            <small>ASSOCIATED TASKS</small>
                            <strong style="color:#ff7777;font-size:1.5rem;">
                                @Model.Tasks.Count
                            </strong>
                        </div>
                    </div>

                </div>

                <!-- Actions -->
                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="mt-4 pt-3 border-top">

                    <div class="d-flex flex-column flex-sm-row
                        justify-content-between gap-2">

                        <a asp-action="Index"
                           class="btn btn-tf-outline">
                            ← Keep project
                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">
                            Delete permanently
                        </button>

                    </div>

                </form>

            </div>

        </div>
    </div>

</div>
