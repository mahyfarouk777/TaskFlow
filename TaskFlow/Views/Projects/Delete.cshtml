```cshtml
@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container py-5">

    <!-- Header -->
    <div class="p-4 p-md-5 mb-4 bg-danger text-white rounded-4 shadow">
        <div class="d-flex align-items-center mb-3">
            <span class="badge bg-white text-danger px-3 py-2 rounded-pill">
                Project Management
            </span>
        </div>

        <h1 class="display-5 fw-bold mb-3">Delete Project</h1>

        <p class="fs-5 mb-0 text-white-50">
            Review the project details before permanently deleting it.
        </p>
    </div>

    <!-- Warning -->
    <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure?
        </h5>
        <p class="mb-0">
            Deleting this project will also delete its associated tasks.
            This action cannot be undone.
        </p>
    </div>

    <!-- Project Details -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h3 class="fw-bold mb-2">@Model.Name</h3>
                            <p class="text-muted mb-0">
                                @(Model.Description ?? "No description provided.")
                            </p>
                        </div>

                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                            Pending Deletion
                        </span>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Start Date</div>
                                <div class="fw-semibold">
                                    @Model.StartDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Deadline</div>
                                <div class="fw-semibold">
                                    @(Model.Deadline?.ToString("dd MMM yyyy") ?? "Not set")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Total Tasks</div>
                                <div class="fw-semibold">
                                    @Model.Tasks.Count
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mt-4 pt-3 border-top">

                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit"
                                    class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>
                                Delete Project
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
```