@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Create Project";
}

<div class="container py-5">

    <!-- Header -->
    <div class="p-4 p-md-5 mb-4 bg-primary text-white rounded-4 shadow">
        <h1 class="display-5 fw-bold">Create Project</h1>
        <p class="fs-5 text-white-50 mb-0">
            Set up a new project and organize your team's work.
        </p>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="h4 fw-bold mb-2">Project Details</h2>
                    <p class="text-secondary mb-4">
                        Fill in the information below to get started.
                    </p>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter project name" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the project goals and scope"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Deadline"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Deadline"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="Deadline"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Create Project &rarr;
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
