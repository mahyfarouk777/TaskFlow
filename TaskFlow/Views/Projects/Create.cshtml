@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Create Project";
}

<div class="tf-page">

    <div class="tf-page-header">
        <div class="tf-eyebrow mb-3">
            WORKSPACE / PROJECTS / NEW
        </div>

        <h1>Start something.</h1>

        <p class="tf-muted mb-0">
            Give your next project a name, direction, and timeline.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="tf-form-card">

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="tf-eyebrow">01 — OVERVIEW</div>
                        <h3 class="fw-bold mt-2">Project information</h3>
                        <p class="tf-muted">
                            Tell us what you're working on.
                        </p>
                    </div>

                    <span class="tf-badge">NEW PROJECT</span>
                </div>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            Project name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Website Redesign" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            Project description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="What are you building? What are the main objectives?"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <div class="tf-eyebrow mb-3">
                        02 — TIMELINE
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="StartDate"
                                   class="form-label">
                                Start date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Deadline"
                                   class="form-label">
                                Deadline
                            </label>

                            <input asp-for="Deadline"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Deadline"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-tf-outline">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-tf">
                            Create project →
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
