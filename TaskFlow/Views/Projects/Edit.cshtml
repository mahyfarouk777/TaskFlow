@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="tf-page">

    <div class="tf-page-header">
        <div class="tf-eyebrow mb-3">
            WORKSPACE / PROJECTS / EDIT
        </div>

        <h1>Refine the vision.</h1>

        <p class="tf-muted mb-0">
            Update your project details and keep everything moving.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="tf-form-card">

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="tf-eyebrow">01 — PROJECT SETTINGS</div>
                        <h3 class="fw-bold mt-2">Edit project information</h3>
                        <p class="tf-muted">
                            Make the necessary changes below.
                        </p>
                    </div>

                    <span class="tf-badge">EDIT MODE</span>
                </div>

                <form asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            Project name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter project name" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description"
                               class="form-label">
                            Project description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the project and its objectives"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <div class="tf-eyebrow mb-3">
                        02 — PROJECT TIMELINE
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="StartDate"
                                   class="form-label">
                                Start date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Deadline"
                                   class="form-label">
                                Deadline
                            </label>

                            <input asp-for="Deadline"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Deadline"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap justify-content-between gap-2">

                        <a asp-action="Index"
                           class="btn btn-tf-outline">
                            ← Back to projects
                        </a>

                        <button type="submit" class="btn btn-tf">
                            Save changes →
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
